[Unit]
Description=Jarvis Sync Watcher (heartbeat + GBrain sync)
After=network-online.target jarvis.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis
EnvironmentFile=/opt/jarvis/.env
ExecStart=/opt/jarvis/.venv/bin/python core/sync/watcher.py
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=append:/opt/jarvis/logs/watcher.log
StandardError=append:/opt/jarvis/logs/watcher.log

[Install]
WantedBy=multi-user.target
