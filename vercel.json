{
  "outputDirectory": "phone",
  "buildCommand": null,
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/",       "destination": "/landing.html" },
    { "source": "/hud",    "destination": "/hud.html" },
    { "source": "/phone",  "destination": "/index.html" },
    { "source": "/design",        "destination": "/mission-control.html" },
    { "source": "/architecture",  "destination": "/architecture.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
