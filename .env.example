# Local model
OLLAMA_HOST=http://localhost:11434
JARVIS_PRIMARY_MODEL=gemma4:31b-cloud
JARVIS_FALLBACK_MODEL=gemma4:31b-cloud

# Cloud models (for agent routing)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
OPENAI_API_KEY=sk-...
JARVIS_OPENAI_MODEL=gpt-5.4
NVIDIA_API_KEY=nvapi-...             # NVIDIA Build API key (for moonshotai/kimi-k2.6, nemotron, etc.)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# GBrain
# Note: GBrain is expected to be cloned externally at C:/Users/YOUR_USERNAME/tools/gbrain
GBRAIN_OPENAI_KEY=sk-...          # for embeddings
SUPABASE_URL=https://...supabase.co
SUPABASE_ANON_KEY=eyJ...
GBRAIN_DB=pglite                  # or "supabase" for cloud

# Hermes / OpenClaw
OPENCLAW_URL=https://your-openclaw.onrender.com
HERMES_SECRET=...                 # shared secret for phone auth
LOCAL_MACHINE_IP=192.168.x.x

# Voice
WHISPER_MODEL=base.en             # or small, medium for accuracy vs speed

# Docker sandbox — absolute path to this repo (used as the /workspace volume mount)
# Linux/macOS: JARVIS_PROJECT_ROOT=/home/YOUR_USERNAME/jarvis
# Windows WSL:  JARVIS_PROJECT_ROOT=/home/YOUR_USERNAME/jarvis  (use WSL path)
JARVIS_PROJECT_ROOT=/home/YOUR_USERNAME/jarvis

# Machine-specific paths for WSL Docker restart + path translation
# Only needed if using JARVIS_SANDBOX_MODE=docker on Windows with WSL
JARVIS_WSL_DISTRO=Ubuntu-24.04
JARVIS_WSL_PROJECT_ROOT=/home/YOUR_USERNAME/jarvis
JARVIS_WIN_PROJECT_ROOT=C:/Users/YOUR_USERNAME/jarvis

# CORS — set to your Cloudflare domain in production, leave * for local dev
JARVIS_CORS_ORIGINS=*

# Logging — set to true to enable DEBUG-level console output
JARVIS_DEBUG=false

# Phase 12: Multi-client robustness
JARVIS_AGENT_TIMEOUT_SEC=300       # seconds before a hung agent.run() is killed (default 5 min)
JARVIS_MAX_WS_MSG_BYTES=1048576    # max WebSocket message size in bytes (default 1 MB)

# SaaS / Multi-user mode (leave unset for self-hosted single-user mode)
# When SUPABASE_JWT_SECRET is set, all WebSocket tokens are validated as Supabase JWTs
# and each user's workspace is isolated under workspaces/<user_id>/.
SUPABASE_JWT_SECRET=              # your Supabase project's JWT secret

# Code execution sandbox (Phase 13)
JARVIS_SANDBOX_MODE=local         # local | docker | e2b
E2B_API_KEY=e2b_...               # only required when JARVIS_SANDBOX_MODE=e2b

# Optional
FIGMA_MCP_TOKEN=...
GITHUB_TOKEN=ghp_...
TWILIO_SID=...                    # for phone number -> brain voice calls
